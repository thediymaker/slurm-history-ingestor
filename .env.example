# =============================================================================
# Slurm History Ingestor - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# The setup script can auto-generate this for you: ./setup.sh
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (Required)
# -----------------------------------------------------------------------------
# PostgreSQL connection string
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# Use sslmode=require (or verify-full) whenever the database is on another host,
# so credentials and job data are not sent in plaintext. sslmode=disable is only
# appropriate for a local, same-host Postgres.
DATABASE_URL=postgres://slurm_user:your_password@localhost:5432/slurm_history?sslmode=require

# -----------------------------------------------------------------------------
# SLURM API CONFIGURATION (Required)
# -----------------------------------------------------------------------------
# Base URL of your Slurm REST API (slurmrestd)
SLURM_SERVER=http://your-slurm-server:6820

# Slurm user account for API authentication
SLURM_API_ACCOUNT=slurm

# JWT token for Slurm API authentication
# Generate with: scontrol token lifespan=3600
SLURM_API_TOKEN=your_jwt_token_here

# -----------------------------------------------------------------------------
# CLUSTER CONFIGURATION (Required)
# -----------------------------------------------------------------------------
# Unique identifier for this cluster (used in multi-cluster setups)
CLUSTER_NAME=mycluster

# -----------------------------------------------------------------------------
# OPTIONAL SETTINGS
# -----------------------------------------------------------------------------
# How often to sync jobs (in seconds). Default: 60 (near real-time).
# Timestamps are normalized to UTC in code, so polling more frequently does
# not cause window drift. Raise this only if sacct/slurmdbd load is a concern.
SYNC_INTERVAL=60

# Overlap window (in minutes) used on every poll after the first run.
# This absorbs delayed slurmdbd / sacct visibility for jobs that finish just
# before a sync but show up moments later. Duplicates are deduplicated by the
# database ON CONFLICT clause on (job_id, cluster, submit_time). Default: 5
LOOKBACK_MINUTES=5

# Slurm REST API version (only for API mode). Default: v0.0.41
SLURM_API_VERSION=v0.0.41

# IANA timezone slurmrestd interprets zone-less ISO timestamps in (API mode only).
# slurmrestd does NOT accept epoch integers and parses ISO timestamps in its own
# local timezone -- NOT UTC and NOT the ingestor's timezone. Set this to match
# the TZ env of the slurmrestd / slurmctld process (often the host's local TZ).
# Examples: "UTC", "America/Phoenix", "America/New_York", "Europe/London".
# Default: UTC
SLURM_API_TZ=UTC

# Initial sync start date for first run (format: YYYY-MM-DD). Default: 2024-01-01
# Set this to control how far back to sync job history on first run.
INITIAL_SYNC_DATE=2024-01-01

# -----------------------------------------------------------------------------
# INGEST MODE (choose one)
# -----------------------------------------------------------------------------
# "api"   - Use Slurm REST API (requires SLURM_SERVER, SLURM_API_TOKEN)
# "sacct" - Use sacct command directly (run on login node, much faster)
INGEST_MODE=sacct

# Path to sacct binary (only for sacct mode). Default: sacct
SACCT_PATH=/usr/bin/sacct

# -----------------------------------------------------------------------------
# PERFORMANCE TUNING (adjust if you experience timeouts)
# -----------------------------------------------------------------------------
# Hours per API request. Lower = fewer jobs per request = less likely to timeout.
# For busy clusters, try 6 or even 1. For quiet clusters, 24 is fine. Default: 24
CHUNK_HOURS=24

# HTTP timeout in seconds for Slurm API requests (API mode only). Default: 120
HTTP_TIMEOUT=120

# Enable debug logging. Default: false
DEBUG=false

# -----------------------------------------------------------------------------
# TIMEZONE (optional)
# -----------------------------------------------------------------------------
# The ingestor normalizes all timestamps to UTC in code, so setting TZ is
# NOT required for correctness. Setting TZ=UTC at the service/container
# level is recommended only for log clarity and consistent subprocess
# defaults (the sacct child is always run with TZ=UTC regardless).
# TZ=UTC

